# FanOut 投票集群环境变量
# 复制为 .env 并填入实际值

# ─── LLM 配置 ─────────────────────────────
GLM_API_KEY=your_glm_api_key_here

# ─── 华为云 OBS 配置 ──────────────────────
OBS_ACCESS_KEY=your_obs_access_key
OBS_SECRET_KEY=your_obs_secret_key
OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET=your-bucket-name

# ─── 外部 manifest-agent 地址 ─────────────
MANIFEST_AGENT_URL=http://manifest-agent:8000

# ─── OpenFang API ────────────────────────
OPENFANG_API=http://localhost:4200

# ─── FanOut 配置 ─────────────────────────
N_PROCESSORS=10
