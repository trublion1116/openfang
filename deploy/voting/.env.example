# ── LLM API Key（必填）──────────────────────────────────────
OPENAI_API_KEY=sk-xxx...xxxx

# ── 华为云 OBS 凭证（MCP S3 服务必填）─────────────────────────
OBS_ACCESS_KEY_ID=your-access-key-id
OBS_SECRET_ACCESS_KEY=your-secret-access-key
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET=your-bucket-name

# ── OBS 可选配置 ────────────────────────────────────────────
# OBS_UPLOAD_PREFIX=uploads/
# OBS_URL_EXPIRES=3600

# ── 投票网关配置 ────────────────────────────────────────────
# Worker 地址（逗号分隔支持多地址）
WORKER_URL=http://mock-worker:9100/a2a
# 并发副本数
N_REPLICAS=10
# 投票策略: exact_match | majority | llm_arbitrate
VOTE_STRATEGY=exact_match
# 单个 Worker 超时（秒）
WORKER_TIMEOUT=120
# 最少成功数（低于此值投票无效）
MIN_SUCCESS=3

# ── LLM 仲裁（仅 VOTE_STRATEGY=llm_arbitrate 时需要）────────
# LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# LLM_API_KEY=sk-xxx
# LLM_MODEL=glm-5.1

# ── Mock Worker 配置（测试用）────────────────────────────────
# MOCK_CORRECT_RATE=0.7
# MOCK_TIMEOUT_RATE=0.05
# MOCK_DELAY_MS=500
# MOCK_DELAY_JITTER=300
