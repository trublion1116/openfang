# ── LLM API Key（必填）──────────────────────────────────────
# OpenFang 默认使用 OpenAI 兼容接口，根据 config.toml 中的 provider 设置
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 华为云 OBS 凭证（MCP S3 服务必填）─────────────────────────
OBS_ACCESS_KEY_ID=your-access-key-id
OBS_SECRET_ACCESS_KEY=your-secret-access-key
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET=your-bucket-name

# ── OBS 可选配置 ────────────────────────────────────────────
# 上传 key 前缀（默认 uploads/）
# OBS_UPLOAD_PREFIX=uploads/
# 签名 URL 有效期秒数（默认 3600）
# OBS_URL_EXPIRES=3600
